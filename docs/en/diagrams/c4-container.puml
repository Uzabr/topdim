@startuml
!include <C4/C4_Container>
title sizbiz — containers
Person(user, "Users", "Buyer, partner, staff")
Container_Boundary(edge, "Public edge") {
  Container(web, "Buyer SPA", "React/Vite/nginx", "Catalog and purchases")
  Container(admin, "Admin SPA", "React/Vite/nginx", "Moderation")
  Container(partner, "Partner SPA", "React/Vite/nginx", "Cabinet and redemption")
  Container(gateway, "API Gateway", "Spring Cloud Gateway", "JWT, routing, rate limit")
}
Container(discovery, "Discovery", "Eureka", "Service registry")
Container(identity, "Identity", "Spring Boot", "Identity/session/staff")
Container(coupon, "Coupon", "Spring Boot", "Catalog/merchant/moderation")
Container(order, "Order", "Spring Boot", "Cart/order/redemption/support")
Container(payment, "Payment", "Spring Boot", "Payment state")
Container(notification, "Notification", "Spring Boot", "Inbox/delivery")
Container(media, "Media", "Spring Boot", "Object access")
Container(bazaar, "Bazaar", "Spring Boot", "Standalone directory")
Container(bot, "Telegram Bot", "Python/aiohttp", "Concierge webhooks")
ContainerDb(pg, "PostgreSQL", "PostgreSQL", "Database per service")
ContainerDb(redis, "Redis", "Redis 7", "Security/cache/rate limit")
ContainerQueue(rabbit, "RabbitMQ", "RabbitMQ 3.13", "Domain events")
ContainerDb(minio, "MinIO", "S3 compatible", "Media objects")
Rel(user, web, "Buyer flow", "HTTPS")
Rel(user, admin, "Admin flow", "HTTPS")
Rel(user, partner, "Partner flow", "HTTPS")
Rel(web, gateway, "REST", "HTTPS/JSON")
Rel(admin, gateway, "REST", "HTTPS/JSON")
Rel(partner, gateway, "REST", "HTTPS/JSON")
Rel(gateway, discovery, "Discovers services", "Eureka")
Rel(gateway, identity, "Routes", "HTTP")
Rel(gateway, coupon, "Routes", "HTTP")
Rel(gateway, order, "Routes", "HTTP")
Rel(gateway, payment, "Routes", "HTTP")
Rel(gateway, notification, "Routes", "HTTP")
Rel(gateway, media, "Routes", "HTTP")
Rel(gateway, bazaar, "Routes", "HTTP")
Rel(gateway, redis, "Rate/token state", "RESP")
Rel(identity, pg, "Own DB", "JDBC")
Rel(coupon, pg, "Own DB", "JDBC")
Rel(order, pg, "Own DB", "JDBC")
Rel(payment, pg, "Own DB", "JDBC")
Rel(notification, pg, "Own DB", "JDBC")
Rel(bazaar, pg, "Own DB", "JDBC")
Rel(order, rabbit, "Publishes/consumes", "AMQP")
Rel(payment, rabbit, "Publishes/consumes", "AMQP")
Rel(coupon, rabbit, "Publishes/consumes", "AMQP")
Rel(notification, rabbit, "Consumes", "AMQP")
Rel(media, minio, "Object CRUD", "S3 API")
Rel(bot, gateway, "Onboarding/approval", "HTTP/JSON")
@enduml
