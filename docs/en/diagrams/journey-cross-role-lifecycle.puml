@startuml
title sizbiz — cross-role lifecycle
left to right direction

actor "Partner" as partner
actor "Moderator" as moderator
actor "Buyer" as buyer
actor "Cashier" as cashier
actor "Administrator" as admin

rectangle "1. Partnership\napplication" as n1
rectangle "2. Offer\npreparation" as n2
rectangle "3. Approval\nand publication" as n3
rectangle "4. Discovery,\norder, demo payment" as n4
rectangle "5. QR/PIN\ncoupon" as n5
rectangle "6. Redemption" as n6
rectangle "7. Statistics,\nreview, support" as n7

partner --> n1
admin --> n1
n1 --> n2
moderator --> n2
n2 --> n3
partner --> n3
n3 --> n4
buyer --> n4
n4 --> n5
n5 --> n6
cashier --> n6
n6 --> n7
buyer --> n7
partner --> n7
admin --> n7
@enduml
