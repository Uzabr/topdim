@startuml
!include <C4/C4_Component>
title Payment service — components
Container_Boundary(pay, "payment-service") {
  Component(ctrl, "PaymentController", "Spring MVC", "Create/status/callback/demo")
  Component(svc, "PaymentService", "Service", "State/idempotency/events")
  Component(repo, "PaymentRepository", "Spring Data JPA", "Persistence")
  Component(listener, "OrderCreatedListener", "AMQP", "Creates payment from order")
}
ContainerDb_Ext(db, "Payment DB", "PostgreSQL")
ContainerQueue_Ext(rabbit, "RabbitMQ", "order/payment exchanges")
Rel(ctrl, svc, "Calls")
Rel(listener, svc, "Creates payment")
Rel(svc, repo, "Reads/writes")
Rel(repo, db, "JDBC")
Rel(listener, rabbit, "Consumes order.created", "AMQP")
Rel(svc, rabbit, "Publishes payment.completed", "AMQP")
@enduml
