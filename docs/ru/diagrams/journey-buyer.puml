@startuml
title sizbiz — путь гостя и покупателя
start
:Открыть каталог;
:Найти и изучить предложение;
if (Нужно персональное действие?) then (да)
  :Регистрация или вход;
endif
:Выбрать опцию и добавить в корзину;
:Создать заказ;
:Demo-оплата;
if (Оплата подтверждена?) then (да)
  :Получить купон QR/PIN;
  :Предъявить партнёру;
  if (Купон и merchant context валидны?) then (да)
    :Погашение — USED;
    :Отзыв или повторная покупка;
  else (нет)
    :Показать отказ и обратиться в поддержку;
  endif
else (нет)
  :Купон не выпускается;
endif
stop
@enduml
