@startuml
title sizbiz — операционные роли
left to right direction

rectangle "Модератор" as mod {
  usecase "Лиды и DRAFT" as m1
  usecase "Согласование" as m2
  usecase "Отзывы, вопросы,\nжалобы" as m3
}
rectangle "Администратор" as admin {
  usecase "Партнёрские заявки" as a1
  usecase "Мерчанты и каталог" as a2
  usecase "Возвраты и\nоперационные случаи" as a3
}
rectangle "Суперадминистратор" as super {
  usecase "Персонал и роли" as s1
  usecase "Блокировки" as s2
  usecase "Audit log" as s3
}

m2 --> a2 : эскалация
m3 --> a3 : спорный случай
a1 --> s1 : привилегированный доступ
a3 --> s3 : контроль
s2 --> s3 : аудит
@enduml
