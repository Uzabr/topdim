@startuml
title sizbiz — сквозной ролевой цикл
left to right direction

actor "Партнёр" as partner
actor "Модератор" as moderator
actor "Покупатель" as buyer
actor "Кассир" as cashier
actor "Администратор" as admin

rectangle "1. Заявка\nпартнёра" as n1
rectangle "2. Подготовка\nпредложения" as n2
rectangle "3. Согласование\nи публикация" as n3
rectangle "4. Поиск,\nзаказ, demo-оплата" as n4
rectangle "5. Купон\nQR/PIN" as n5
rectangle "6. Погашение" as n6
rectangle "7. Статистика,\nотзыв, поддержка" as n7

partner --> n1
admin --> n1
n1 --> n2
moderator --> n2
n2 --> n3
partner --> n3
n3 --> n4
buyer --> n4
n4 --> n5
n5 --> n6
cashier --> n6
n6 --> n7
buyer --> n7
partner --> n7
admin --> n7
@enduml
