@startuml
title sizbiz — путь мерчанта
start
:Отправить партнёрскую заявку;
:Проверка администратором;
if (Заявка одобрена?) then (да)
  :Создать/связать merchant и owner;
  :Подготовить профиль и основную локацию;
  :Создать заявку на предложение — LEAD;
  :Модератор готовит — DRAFT;
  :Отправить на согласование;
  if (Партнёр одобряет?) then (да)
    :Опубликовать — ACTIVE;
    :Получать продажи и погашения;
    :Смотреть статистику;
  else (нужны правки)
    :REVISION_REQUESTED;
    :Вернуть в подготовку;
  endif
else (нет)
  :Сообщить решение;
endif
stop
@enduml
