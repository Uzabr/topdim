# ================================================
# TopDim — Environment Variables
# ================================================
# Скопируйте этот файл в .env и заполните значения.
# НИКОГДА не коммитьте .env в Git!
#
# cp .env.example .env
# ================================================

# ==================== Database ====================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=topdim
DB_PASSWORD=CHANGE_ME_strong_password_here

# ==================== Redis ====================
REDIS_HOST=localhost
REDIS_PORT=6379

# ==================== RabbitMQ ====================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=topdim
RABBITMQ_PASSWORD=CHANGE_ME_strong_password_here

# ==================== JWT ====================
# Генерация: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_use_openssl_rand_base64_32

# ==================== MinIO ====================
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=topdim
MINIO_SECRET_KEY=CHANGE_ME_strong_password_here
MINIO_BUCKET=topdim-media

# ==================== CORS ====================
# Для production — укажите реальные домены
CORS_ORIGIN_1=http://localhost:3000
CORS_ORIGIN_2=http://localhost:5173

# ==================== Email ====================
MAIL_USERNAME=
MAIL_PASSWORD=

# ==================== Monitoring ====================
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_grafana_password

# ==================== Spring Profile ====================
# Для production: SPRING_PROFILES_ACTIVE=prod
# (отключает Swagger, включает HSTS и другие prod-настройки)
SPRING_PROFILES_ACTIVE=

# ==================== Eureka ====================
EUREKA_HOST=localhost
