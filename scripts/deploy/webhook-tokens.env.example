# topdim — EasyPanel deploy webhook tokens (SERVER ONLY, never commit real values)
# --------------------------------------------------------------------------------
# Copy to /home/deploy/webhook-tokens.env on the prod server, fill real tokens,
# then: chown deploy:deploy /home/deploy/webhook-tokens.env && chmod 600 it.
#
# One line per service: <service>=<easypanel-deploy-token>
# Get each token in EasyPanel: service → «Развёртывание» → «Триггер развёртывания».
# The full webhook URL is http://localhost:3000/api/deploy/<token> (deploy.sh builds it).
# ⚠️ Regenerate any token that has ever been pasted into a chat/log before use.
#
# Service names MUST match the ALLOWED list in scripts/deploy/deploy.sh and the CD
# build matrix. bazaar-service is intentionally absent (not built/deployed).

discovery-server=REPLACE_ME
api-gateway=REPLACE_ME
identity-service=REPLACE_ME
coupon-service=REPLACE_ME
order-service=REPLACE_ME
payment-service=REPLACE_ME
notification-service=REPLACE_ME
media-service=REPLACE_ME
web-app=REPLACE_ME
admin-app=REPLACE_ME
partner=REPLACE_ME
