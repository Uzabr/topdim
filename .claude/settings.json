{
    "permissions": {
        "defaultMode": "plan",
        "allow": [
            "Read(./**)",
            "Edit(./src/**)",
            "Edit(./services/**)",
            "Edit(./infrastructure/**)",
            "Edit(./shared/**)",
            "Edit(./docs/**)",
            "Edit(./.claude/**)",
            "Edit(./CLAUDE.md)",
            "Bash(git status*)",
            "Bash(git diff*)",
            "Bash(git log*)",
            "Bash(git branch*)",
            "Bash(./gradlew test*)",
            "Bash(./gradlew build*)",
            "Bash(./gradlew check*)",
            "Bash(./mvnw test*)",
            "Bash(./mvnw package*)",
            "Bash(docker compose ps*)",
            "Bash(docker compose logs*)",
            "Bash(docker ps*)"
        ],
        "ask": [
            "Bash(git add*)",
            "Bash(git commit*)",
            "Bash(git checkout*)",
            "Bash(git merge*)",
            "Bash(git rebase*)",
            "Bash(docker compose up*)",
            "Bash(docker compose down*)",
            "Bash(docker compose restart*)",
            "Bash(docker system*)",
            "Bash(kubectl *)",
            "Bash(terraform *)"
        ],
        "deny": [
            "Read(./.env)",
            "Read(./.env.*)",
            "Read(./**/.env)",
            "Read(./**/.env.*)",
            "Read(./secrets/**)",
            "Read(./**/secrets/**)",
            "Read(./**/*.pem)",
            "Read(./**/*.key)",
            "Read(./**/credentials*)",
            "Edit(./.git/**)",
            "Bash(rm -rf *)",
            "Bash(git push*)",
            "Bash(git reset --hard*)",
            "Bash(git clean*)",
            "Bash(docker compose down -v*)",
            "Bash(docker volume rm*)",
            "Bash(kubectl delete*)",
            "Bash(terraform apply*)",
            "Bash(terraform destroy*)"
        ]
    }
}